{
  "name": "iroko-agent",
  "version": "0.1.0",
  "description": "Agent de code et assistant de travail autonome en circuit fermé Iroko",
  "author": "Iroko Dev <dev@iroko.ai>",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "agent": "tsx server/index.ts",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-electron/main.js && esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-electron/preload.cjs",
    "build": "npm run build:client && npm run build:server && npm run build:electron",
    "start": "node dist-server/index.js",
    "electron": "npm run build && electron dist-electron/main.js",
    "package": "npm run build && electron-builder",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import ./tests/setup_test_env.js --import tsx --test --test-timeout=60000 tests/*.test.mjs",
    "test:strict": "node --import ./tests/setup_test_env.js --import tsx --test --test-timeout=60000 tests/*.test.mjs",
    "e2e": "node --import ./tests/setup_test_env.js --test tests/e2e/*.test.mjs",
    "lint:tokens": "node scripts/lint_tokens.mjs",
    "lint:fr": "node scripts/lint_fr.mjs",
    "ui:check": "node scripts/ui_check.mjs",
    "audit:a11y": "node tools/audit/audit_a11y.mjs",
    "audit:perf": "node tools/audit/audit_perf.mjs",
    "audit:responsive": "node tools/audit/audit_responsive.mjs",
    "audit:tasks": "node tools/audit/audit_tasks.mjs",
    "audit:all": "node tools/audit/run_all.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "web-vitals": "^6.2.2"
  }
}
